<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flsignpad_dual"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <ImageButton
            android:id="@+id/cancel_button_dual"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="right"
            android:background="#00ffffff"
            android:enabled="true"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_close_popup" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="15"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:background="@drawable/bg_dialog_top"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:padding="20dp"
            android:text="카드 서명"
            android:textColor="#171717"
            android:textSize="24sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10"
            android:background="#fff"
            android:orientation="vertical"
            android:paddingTop="40dp">

            <LinearLayout
                android:id="@+id/signature_pad_container_dual"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginHorizontal="40dp"
                android:layout_weight="8"
                android:background="#959595"
                android:padding="2dp">

                <com.github.gcacace.signaturepad.views.SignaturePad
                    android:id="@+id/signature_pad_dual"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#FFFFFF" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_margin="20dp"
                android:layout_weight="2"
                android:fontFamily="sans-serif-medium"
                android:text="서명해주세요"
                android:textAlignment="center"
                android:textColor="#171717"
                android:textSize="28sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/buttons_container_dual"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:orientation="horizontal">

            <Button
                android:id="@+id/clear_button_dual"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_dialog_bottom_left"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:text="재서명"
                android:textColor="#180900"
                android:textSize="25sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/save_button_dual"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_dialog_bottom_right"
                android:enabled="false"
                android:fontFamily="sans-serif-medium"
                android:text="서명완료"
                android:textColor="#fff"
                android:textSize="25sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
