<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="KEYIN 입력해주세요"
        android:textSize="20dp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etcashinputnum"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/border"
        android:enabled="false"
        android:maxLength="13"
        android:padding="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/Button1"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/numpad_1"
                android:onClick="onClick"
                android:tag="1" />

            <Button
                android:id="@+id/Button2"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/numpad_2"
                android:onClick="onClick"
                android:tag="2" />

            <Button
                android:id="@+id/Button3"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/numpad_3"
                android:onClick="onClick"
                android:tag="3" />

            <Button
                android:id="@+id/Button4"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/numpad_4"
                android:onClick="onClick"
                android:tag="4" />

            <Button
                android:id="@+id/Button5"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/numpad_5"
                android:onClick="onClick"
                android:tag="5" />

            <Button
                android:id="@+id/ButtonBackSpace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="4dp"
                android:layout_marginRight="4dp"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                android:layout_weight="2"
                android:background="@drawable/numpad_bs"
                android:onClick="onClick" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/Button6"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/numpad_6"
                android:onClick="onClick"
                android:tag="6"/>

            <Button
                android:id="@+id/Button7"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/numpad_7"
                android:onClick="onClick"
                android:tag="7"/>

            <Button
                android:id="@+id/Button8"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/numpad_8"
                android:onClick="onClick"
                android:tag="8" />

            <Button
                android:id="@+id/Button9"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/numpad_9"
                android:onClick="onClick"
                android:tag="9" />

            <Button
                android:id="@+id/Button0"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/numpad_0"
                android:onClick="onClick"
                android:tag="0" />

            <Button
                android:id="@+id/Button010"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/numpad_010"
                android:onClick="onClick" />

            <Button
                android:id="@+id/ButtonClear"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:background="@drawable/numpad_clear"
                android:onClick="onClick"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ButtonExit"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@color/DarkRed"
                android:onClick="onClick"
                android:text="취소"
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/White"/>

            <Button
                android:id="@+id/ButtonOK"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:background="@color/CornflowerBlue"
                android:onClick="onClick"
                android:text="확인"
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/White"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>